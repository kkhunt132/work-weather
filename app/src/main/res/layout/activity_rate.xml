<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1D2129"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rate App"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>

        <ImageView
            android:id="@+id/btn_close_rate"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close"/>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enjoying the app?"
        android:textColor="@color/white"
        android:layout_marginTop="50dp"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Give us a rating"
        android:textColor="#777E90"
        android:layout_marginTop="10dp"
        android:textSize="16sp"/>

    <RatingBar
        android:id="@+id/rating_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:numStars="5"
        android:stepSize="1"
        android:progressTint="#FFD700"
        android:secondaryProgressTint="#FFD700"
        android:progressBackgroundTint="#444955"/>

    <Button
        android:id="@+id/btn_rate_now"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Rate Now"
        android:layout_marginTop="30dp"
        android:backgroundTint="#4E91F2"/>

</LinearLayout>
