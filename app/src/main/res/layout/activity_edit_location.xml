<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1D2129"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Location"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>

        <ImageView
            android:id="@+id/btn_close_edit"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close"/>
    </RelativeLayout>

    <EditText
        android:id="@+id/et_search_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search Location"
        android:textColorHint="#777E90"
        android:textColor="@color/white"
        android:layout_marginTop="30dp"
        android:backgroundTint="#444955"
        android:inputType="text"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Chennai Box -->
            <RelativeLayout
                android:id="@+id/container_chennai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:layout_marginBottom="10dp"
                android:background="#2C313B">
                <TextView
                    android:id="@+id/tv_chennai_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chennai"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:id="@+id/btn_delete_chennai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Delete"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </RelativeLayout>

            <!-- New Delhi Box -->
            <RelativeLayout
                android:id="@+id/container_delhi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:layout_marginBottom="10dp"
                android:background="#2C313B">
                <TextView
                    android:id="@+id/tv_delhi_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Delhi"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:id="@+id/btn_delete_delhi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Delete"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </RelativeLayout>

            <!-- Rajkot Box (Hidden by default or to be removed) -->
            <RelativeLayout
                android:id="@+id/container_rajkot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:layout_marginBottom="10dp"
                android:background="#2C313B"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tv_rajkot_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rajkot"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:id="@+id/btn_delete_rajkot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Delete"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </RelativeLayout>

            <!-- Ahmedabad Box (Hidden by default or to be removed) -->
            <RelativeLayout
                android:id="@+id/container_ahmedabad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:layout_marginBottom="10dp"
                android:background="#2C313B"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tv_ahmedabad_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ahmedabad"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:id="@+id/btn_delete_ahmedabad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Delete"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
