                        android:id="@+id/tv_notif3_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="--°C"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </RelativeLayout>
                <TextView
                    android:id="@+id/tv_detail_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Live update coming soon..."
                    android:textColor="#B0B5C1"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Notification 4 (Mumbai) -->
            <LinearLayout
                android:id="@+id/notif_card_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dashboard_item_bg"
                android:layout_marginBottom="12dp"
                android:padding="15dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <RelativeLayout
                    android:layout_width="match_parent"
