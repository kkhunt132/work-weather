                    android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Notification 5 (Kolkata) -->
            <LinearLayout
                android:id="@+id/notif_card_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dashboard_item_bg"
                android:layout_marginBottom="12dp"
                android:padding="15dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_notif5_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KOLKATA"
                        android:textColor="#4E91F2"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tv_notif5_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_notif5_city"
                        android:text="Updated: --:--"
                        android:textColor="#8E94A3"
                        android:textSize="11sp"/>
                    <ImageView
                        android:id="@+id/img_notif5_icon"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/first"/>
                    <TextView
                        android:id="@+id/tv_notif5_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="--°C"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </RelativeLayout>
                <TextView
                    android:id="@+id/tv_detail_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Live update coming soon..."
                    android:textColor="#B0B5C1"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
