<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1D2129"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weather Notifications"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>

        <ImageView
            android:id="@+id/btn_close_notifications"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close"
            app:tint="@color/white"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Notification 1 (Delhi) -->
            <LinearLayout
                android:id="@+id/notif_card_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dashboard_item_bg"
                android:layout_marginBottom="12dp"
                android:padding="15dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_notif1_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DELHI"
                        android:textColor="#4E91F2"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tv_notif1_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_notif1_city"
                        android:text="Updated: --:--"
                        android:textColor="#8E94A3"
                        android:textSize="11sp"/>
                    <ImageView
                        android:id="@+id/img_notif1_icon"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/first"/>
                    <TextView
                        android:id="@+id/tv_notif1_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="--°C"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </RelativeLayout>
                <TextView
                    android:id="@+id/tv_detail_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Live update coming soon..."
                    android:textColor="#B0B5C1"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Notification 2 (Bangalore) -->
            <LinearLayout
                android:id="@+id/notif_card_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dashboard_item_bg"
                android:layout_marginBottom="12dp"
                android:padding="15dp"
                android:orientation="vertical"
                android:clickable="true"
