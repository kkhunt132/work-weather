<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_content_p10"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1D2129"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_profile"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#2C313B">

            <ImageView
                android:id="@+id/img_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/emoji"
                android:scaleType="centerCrop"
                android:contentDescription="Profile"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/card_profile"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:text="User Name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 3 Dots Menu Button -->
        <ImageView
            android:id="@+id/btn_menu_p10"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu" />
    </RelativeLayout>

    <!-- Logout Option (Initially Hidden) -->
    <TextView
        android:id="@+id/btn_logout_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/dashboard_item_bg"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="Logout"
        android:textColor="@color/white"
        android:visibility="gone"
        android:layout_marginTop="-20dp"
        android:layout_marginEnd="10dp"
        android:elevation="5dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Location Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginBottom="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#444955"
            android:layout_marginHorizontal="15dp"/>
        <TextView
            android:id="@+id/btn_edit_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:textColor="#00D2FF"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="30dp">

        <!-- Chennai -->
        <RelativeLayout
            android:id="@+id/btn_chennai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/icon_loc1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="@color/white"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/icon_loc1"
                android:layout_marginStart="15dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chennai, Tamil Nadu"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_chennai_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="#777E90"
                    android:textSize="14sp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- Gondal -->
        <RelativeLayout
            android:id="@+id/btn_delhi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/icon_loc2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="@color/white"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/icon_loc2"
                android:layout_marginStart="15dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delhi, India"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_delhi_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="#777E90"
                    android:textSize="14sp"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tools"
        android:textColor="#777E90"
        android:textSize="14sp"
        android:layout_marginBottom="15dp"/>

    <!-- Tools Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout android:id="@+id/btn_notifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_notif" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_popup_reminder" app:tint="@color/white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notifications" android:textColor="@color/white" android:textSize="18sp" android:layout_toEndOf="@id/icon_notif" android:layout_marginStart="15dp"/>
        </RelativeLayout>

        <RelativeLayout android:id="@+id/btn_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_settings" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_manage" app:tint="@color/white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textColor="@color/white" android:textSize="18sp" android:layout_toEndOf="@id/icon_settings" android:layout_marginStart="15dp"/>
        </RelativeLayout>

        <RelativeLayout android:id="@+id/btn_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_feedback" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_send" app:tint="@color/white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send feedback" android:textColor="@color/white" android:textSize="18sp" android:layout_toEndOf="@id/icon_feedback" android:layout_marginStart="15dp"/>
        </RelativeLayout>

        <RelativeLayout android:id="@+id/btn_rate" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_rate" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/btn_star_big_on" app:tint="@color/white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate this app" android:textColor="@color/white" android:textSize="18sp" android:layout_toEndOf="@id/icon_rate" android:layout_marginStart="15dp"/>
        </RelativeLayout>

        <RelativeLayout android:id="@+id/btn_share" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_share" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_share" app:tint="@color/white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share your weather" android:textColor="@color/white" android:textSize="18sp" android:layout_toEndOf="@id/icon_share" android:layout_marginStart="15dp"/>
        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
